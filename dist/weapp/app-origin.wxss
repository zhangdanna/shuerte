.h5-button,.h5-form,.h5-input,.h5-label,.h5-textarea,image,navigator,page,scroll-view,swiper,swiper-item,text,view{-webkit-box-sizing:border-box;box-sizing:border-box}page{background-color:#fbf6ee;color:#1a1815;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,PingFang SC,Hiragino Sans GB,sans-serif;font-size:28rpx;height:100%;line-height:1.5;min-height:100vh}.h5-body,.h5-html{background-color:#f3eee7;color:#1a1815;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,PingFang SC,Hiragino Sans GB,sans-serif;height:100%;line-height:1.5;margin:0;overflow:hidden}.h5-html .h5-body > .taro-tabbar__container{background-color:#fbf6ee;-webkit-box-sizing:border-box;box-sizing:border-box;height:var(--app-height,100vh);margin:0 auto;overflow:hidden;padding-top:env(safe-area-inset-top);width:var(--app-width,100%)}.h5-html .taro_router{height:100%;max-height:100%}.h5-html .taro_router .taro_page{height:100%;max-height:100%;overflow-x:hidden;overflow-y:auto;-webkit-overflow-scrolling:touch}.h5-html .taro-tabbar__panel{overflow:hidden}.h5-html .taro-tabbar__tabbar-bottom{-webkit-box-sizing:content-box;box-sizing:content-box;margin-bottom:0;padding-bottom:env(safe-area-inset-bottom)}